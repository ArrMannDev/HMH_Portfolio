# Supabase Project URL and publishable key (never use a secret/service-role key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Stable production origin, without a path or trailing slash.
NEXT_PUBLIC_SITE_URL=https://hmh-portfolio-nine.vercel.app

# Published Supabase projects are the default. Set local only for an explicit
# rollback to the preserved static collection. Restart/redeploy after changing.
ARTWORK_SOURCE=supabase

# Existing Project_URL and Publishable_API_Key names are also supported
# server-side. Keep real credentials in .env or .env.local, not this file.
